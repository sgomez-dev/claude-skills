{
  "name": "claude-skills-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate",
    "test": "vitest run",
    "translations:plan": "npm run generate && tsx scripts/translations.ts plan",
    "translations:check": "npm run generate && tsx scripts/translations.ts check",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "check:private": "tsx scripts/check-no-private.ts"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "gray-matter": "4.0.3",
    "motion": "13.4.4",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
